# ---------------------------------------------------------------
# AI phone demo line — copy to .env and fill in.
# NEVER commit a real .env (.gitignore already blocks it).
#
# The service runs with NONE of these set: the router falls back to
# its deterministic classifier, and calendar/SMS run in mock mode.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=3001
# Bind address. Keep on loopback in production — Nginx proxies to it,
# so the Node port is never reachable from the internet.
HOST=127.0.0.1

# Public HTTPS base URL of THIS service.
#   production: https://voice.youraidepartment.ai
#   local dev:  your ngrok / cloudflared HTTPS URL
# TWILIO_CONVERSATION_RELAY_URL is derived from it (wss://…/twilio/conversation)
# if left blank.
PUBLIC_BASE_URL=
TWILIO_CONVERSATION_RELAY_URL=

# --- Security --------------------------------------------------
# Verifies the X-Twilio-Signature header. Defaults ON when
# NODE_ENV=production, and requires TWILIO_AUTH_TOKEN. Without it,
# anyone who learns the webhook URL can start calls.
VALIDATE_TWILIO_SIGNATURE=
# Trust X-Forwarded-For. ON in production (behind Nginx); must stay OFF
# if the port is ever exposed directly, or clients can spoof their IP.
TRUST_PROXY=
# Seconds to let in-progress calls finish on restart. Keep below
# systemd TimeoutStopSec (35s).
SHUTDOWN_GRACE_MS=25000

# --- Anthropic -------------------------------------------------
# Without this the call still connects, but the specialist cannot
# converse — set it for a real demo.
ANTHROPIC_API_KEY=

# CLAUDE_MODEL is the blunt instrument — it sets every role at once.
# The per-role variables below win over it, and exist because routing
# and conversation are different jobs: routing sits on the critical
# path with the caller listening to silence, so it wants the fastest
# model; the specialist is holding a conversation and wants a stronger
# one. Leave them blank to use the defaults in src/claude/models.ts.
CLAUDE_MODEL=
CLAUDE_ROUTER_MODEL=
CLAUDE_SPECIALIST_MODEL=
CLAUDE_SUMMARY_MODEL=

# Tuning knobs. Specialist replies are capped at roughly three spoken
# sentences — anything longer is a monologue the caller interrupts.
CLAUDE_ROUTER_MAX_TOKENS=
CLAUDE_SPECIALIST_MAX_TOKENS=
CLAUDE_SPECIALIST_TEMPERATURE=

ROUTER_CONFIDENCE_THRESHOLD=0.6

# --- Twilio ----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ConversationRelay text-to-speech. These defaults are exactly what the
# first successful production call used — changing them changes what
# every caller hears, so override deliberately or not at all.
TWILIO_TTS_VOICE=en-US-Journey-O
TWILIO_TTS_LANGUAGE=en-US

# --- Deployment mode -------------------------------------------
# demo   = the Your AI Department sales line. The caller hears the demo
#          introduction, role-plays a scenario, and may be offered a
#          discovery call.
# client = a business's own receptionist. The demo greeting, the demo
#          host and the whole Your AI Department sales layer are absent.
#          A client's customer must never hear us mentioned.
#
# Defaults to demo, because this number IS the demo line. Anything other
# than the exact string "client" stays demo rather than half-switching.
DEPLOYMENT_MODE=demo

# Client mode only. Ignored entirely in demo mode.
CLIENT_GREETING=
BUSINESS_NAME=

# --- Service area ----------------------------------------------
# The VPS runs in UTC. Everything the caller hears or is charged for —
# the current time, which rate band applies, ETA windows, same-day
# language — uses THIS timezone instead.
#
# The timezone is configured, never derived from the state code: several
# US states span two zones, so a state alone cannot settle it. A client
# operating across zones sets the one their dispatch runs on.
SERVICE_AREA_STATE=FL
SERVICE_AREA_TIMEZONE=America/New_York

# --- Google Calendar -------------------------------------------
# Leave disabled to use the mock calendar.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Action providers ------------------------------------------
# Tow dispatch, e-signature packets, secure uploads and partner
# referrals are ALL mock in this build. No variable is needed to run
# them — the agent is told each provider's mode and describes a mocked
# action as something the system does rather than something it just did.
#
# Base for generated upload links. The backend builds every URL; the
# model has no parameter for one. Defaults to an .invalid host so a
# demo link resolves nowhere rather than somewhere unexpected.
UPLOAD_LINK_BASE_URL=https://upload.example-demo.invalid

# Base for secure roadside location links. Same rule: the backend builds
# every URL with an opaque random token, and the token is never logged.
LOCATION_LINK_BASE_URL=https://loc.example-demo.invalid

# --- Mocks -----------------------------------------------------
# Both fail safe: even set to false, the real path is only used when
# the matching credentials are actually present.
MOCK_CALENDAR_MODE=true
MOCK_SMS_MODE=true

# --- Human transfer --------------------------------------------
HUMAN_TRANSFER_NUMBER=

# --- Logging ---------------------------------------------------
# Transcripts contain everything the caller said. Off by default.
LOG_TRANSCRIPTS=false
LOG_LEVEL=info

# Full end-of-call summary (who called, what they needed, what was
# captured). The anonymous analytics event is always emitted; this
# controls the human-readable record, which carries contact details.
CALL_SUMMARY_ENABLED=true

# ---------------------------------------------------------------
# Demo pricing
# ---------------------------------------------------------------
# The plumbing demo company's published rates live in
# src/business/pricing.ts, not here, because they are a structure
# rather than three numbers: bands, hours, the repair policy and the
# credit rule have to stay consistent with each other.
#
# A real client's rates are supplied the same way — see
# docs/voice-agent-client-onboarding.md. Nothing in this file needs to
# change to run the current demo.
