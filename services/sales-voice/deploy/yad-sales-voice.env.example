# /etc/yad-sales-voice.env
#
# Owned by root, readable only by the service user. Never in git, never in a chat
# message, never in a source file.
#
#   sudo install -o root -g yadsalesvoice -m 0640 /dev/null /etc/yad-sales-voice.env
#   sudo -e /etc/yad-sales-voice.env
#
# This file is the template. Copy the shape, not the values.

# --- required to run at all -------------------------------------------------
SALES_VOICE_PORT=3002
SALES_VOICE_BIND=127.0.0.1
SALES_VOICE_PATH_PREFIX=/outbound
PUBLIC_VOICE_BASE_URL=https://voice.youraidepartment.ai
SALES_VOICE_TRUST_PROXY=true

# --- Twilio ------------------------------------------------------------------
# Signature validation stays enforced. Setting this to false is a local debugging
# act and must never be done on this host: it would let anyone who learns the URL
# start calls.
TWILIO_VALIDATE_SIGNATURES=true

# Paste the real values here, on the server, with `sudo -e`. Nowhere else.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Only a YAD-controlled number may be presented as caller ID. No rotation.
OUTBOUND_APPROVED_CALLER_IDS=

# --- speech ------------------------------------------------------------------
TWILIO_TTS_VOICE=en-US-Journey-O
TWILIO_TTS_LANGUAGE=en-US
TWILIO_PARTIAL_PROMPTS=true

# --- deliberately absent -----------------------------------------------------
# Outbound calling stays off until an operator arms it in the database, and the
# pilot mode lives there rather than here so a restart cannot arm it by accident.
# Do not add OUTBOUND_DIAL_ENABLED or a mode variable to this file.
