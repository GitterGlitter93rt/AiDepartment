{
  "name": "@yad/sales-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "migrate": "tsx src/bin/migrate.ts",
    "api": "tsx src/bin/api.ts",
    "api:watch": "tsx watch src/bin/api.ts",
    "worker": "tsx src/bin/worker.ts",
    "seed": "tsx src/bin/seed.ts",
    "import": "tsx src/bin/import.ts",
    "test": "LOG_LEVEL=silent tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "sync-verticals": "tsx src/bin/sync-verticals.ts",
    "demo:research": "tsx src/bin/demo-research.ts",
    "start:api": "node dist/bin/api.js",
    "start:worker": "node dist/bin/worker.js",
    "migrate:prod": "node dist/bin/migrate.js",
    "roleplay": "tsx src/bin/roleplay.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
