# YAD Sales Brain — copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development

POSTGRES_DB=yad_sales
POSTGRES_USER=yad_sales
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgres://yad_sales:CHANGEME@127.0.0.1:5432/yad_sales

SALES_PORTAL_PORT=8080
SALES_PORTAL_BIND=127.0.0.1
SESSION_SECRET=
SESSION_COOKIE_SECURE=false

# Contact resolution: PUBLIC_ONLY | PUBLIC_THEN_PAID | PAID_ALLOWED_FOR_TIER_A | IMPORT_ONLY
CONTACT_ENRICHMENT_MODE=PUBLIC_ONLY

# Optional paid enrichment (NOT required). Leave blank to keep Apollo disabled.
APOLLO_API_KEY=

# Microsoft Graph booking adapter (Gate T7). Leave blank until app registration exists.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
BOOKING_CALENDAR_UPN=michael@youraidepartment.ai
BOOKING_TIMEZONE=America/New_York

# Outbound safety switches. Never flip without the explicit pilot gate.
OUTBOUND_DIAL_ENABLED=false
OUTBOUND_EMAIL_ENABLED=false

# Cal.com is the booking authority (Gate T7); Graph is a fallback via BOOKING_PROVIDER.
BOOKING_PROVIDER=calcom
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_WEBHOOK_SECRET=
