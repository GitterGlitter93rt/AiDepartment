[Unit]
Description=YAD Sales Brain API and rep portal
Documentation=file:///home/roothecks/YAD-Sales-Brain/docs/09-software/SALES-BRAIN-RUNTIME.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# The dedicated Sales Brain worktree, not the general repository checkout, which gets
# switched between branches. See SALES-BRAIN-RUNTIME.md.
WorkingDirectory=/home/roothecks/YAD-Sales-Brain/services/sales-brain
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
# Refuses to start from a tree that is not the Sales Brain on its own branch, with a
# build that matches its source. This is what the old unit had no equivalent of.
ExecStartPre=/home/roothecks/YAD-Sales-Brain/services/sales-brain/deploy/assert-runtime.sh --built
# The database must be reachable before the API claims to be healthy.
ExecStartPre=/usr/bin/docker compose --env-file /home/roothecks/YAD-Sales-Brain/services/sales-brain/.env -f /home/roothecks/YAD-Sales-Brain/services/sales-brain/deploy/docker-compose.yml up -d
# There is deliberately NO migration step here. Ordinary startup must not mutate the
# schema: a restart is what you reach for when something is already wrong, so it is
# the worst moment to also apply DDL, and it would make every reboot a deployment.
# Schema changes are explicit and separate:
#     cd /home/roothecks/YAD-Sales-Brain/services/sales-brain && node dist/bin/migrate.js
# Do not reintroduce this as an ExecStartPre without an explicit decision to.
ExecStart=/usr/bin/env node dist/bin/api.js
Restart=always
RestartSec=5
StandardOutput=append:/home/roothecks/YAD-Sales-Brain/services/sales-brain/logs/api.log
StandardError=append:/home/roothecks/YAD-Sales-Brain/services/sales-brain/logs/api.err.log

# The portal holds prospect data; keep its blast radius small.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/roothecks/YAD-Sales-Brain/services/sales-brain/logs

[Install]
WantedBy=default.target
