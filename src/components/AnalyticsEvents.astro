---
// Shared GA4 (via GTM) conversion-event tracking.
// Uses event delegation on document.body so it works site-wide without
// modifying individual button/link markup on every page. Fires only
// first-party dataLayer pushes — never claims a booking was completed,
// only that the user clicked toward one (per docs/00-company/launch-decisions.md
// Sprint 9 GA4 event architecture: click events, not fabricated completion
// events).
//
// Assessment start tracking uses the SHARED event family
// (ai_assessment_start) for both funnels, distinguished by non-PII
// parameters from src/lib/assessment/ga4Events.ts:
//   - Free Opportunity Assessment (#a-quick-start-btn on
//     /free-ai-assessment/) -> assessment_type "free_opportunity",
//     assessment_version "short_v1"
//   - Comprehensive 64-question engine (#a-start-btn on
//     /ai-assessment/full/) -> assessment_type "comprehensive_audit"
import { SCHEDULING } from '../lib/scheduling';
import {
  ASSESSMENT_EVENTS,
  ASSESSMENT_TYPE,
  buildAssessmentStartParams,
} from '../lib/assessment/ga4Events';
---

<script is:inline define:vars={{
  strategyUrl: SCHEDULING.strategyCall.url,
  enterpriseUrl: SCHEDULING.enterpriseDiscussion.url,
  trainingUrl: SCHEDULING.trainingConsultation.url,
  executiveUrl: SCHEDULING.executiveAdvisory.url,
  comprehensiveAuditUrl: SCHEDULING.comprehensiveAudit.url,
  assessmentStartEventName: ASSESSMENT_EVENTS.start,
  freeStartParams: buildAssessmentStartParams(ASSESSMENT_TYPE.free),
  comprehensiveStartParams: buildAssessmentStartParams(ASSESSMENT_TYPE.comprehensive),
}}>
  window.dataLayer = window.dataLayer || [];
  let assessmentStartFired = false;

  function pushEvent(eventName, extra) {
    window.dataLayer.push(Object.assign({ event: eventName }, extra || {}));
  }

  // The six UTM fields, read at call time from the snapshot published by
  // AttributionCapture.astro. Read lazily (not captured once at parse)
  // because this inline script runs before that module executes.
  // Hard-coded allowlist: this script must never forward an arbitrary
  // object into the dataLayer.
  var CAMPAIGN_KEYS = ['utm_id', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

  function withCampaign(params) {
    var merged = Object.assign({}, params);
    try {
      var snapshot = window.yaiCampaign || {};
      for (var i = 0; i < CAMPAIGN_KEYS.length; i++) {
        var key = CAMPAIGN_KEYS[i];
        var value = snapshot[key];
        if (typeof value === 'string' && value.length > 0) merged[key] = value;
      }
    } catch (e) {
      /* campaign enrichment is best-effort */
    }
    return merged;
  }

  document.body.addEventListener('click', (e) => {
    const link = e.target instanceof Element ? e.target.closest('a') : null;
    if (link) {
      const href = link.getAttribute('href') || '';

      // Matched via startsWith (not exact equality) because
      // AttributionCapture.astro may have appended attribution query
      // parameters onto these same links' href by the time a user
      // actually clicks them. The boundary check (exact match, or
      // followed by ? or #) prevents a coincidental prefix match
      // against some unrelated, longer URL.
      const isSchedulingMatch = (linkHref, base) => linkHref === base || linkHref.startsWith(base + '?') || linkHref.startsWith(base + '#');

      if (isSchedulingMatch(href, strategyUrl)) {
        pushEvent('booking_click_strategy', { link_url: href });
      } else if (isSchedulingMatch(href, enterpriseUrl)) {
        pushEvent('booking_click_enterprise', { link_url: href });
      } else if (isSchedulingMatch(href, trainingUrl)) {
        pushEvent('booking_click_training', { link_url: href });
      } else if (isSchedulingMatch(href, executiveUrl)) {
        pushEvent('booking_click_executive_advisory', { link_url: href });
      } else if (isSchedulingMatch(href, comprehensiveAuditUrl)) {
        // Paid Comprehensive AI Business Audit booking click — non-PII
        // only: the enriched href (attribution click IDs / UTMs are
        // not personal data) plus nothing else, same shape as the other
        // booking_click_* events.
        pushEvent('booking_click_comprehensive_audit', { link_url: href });
      }

      // Resource CTA clicks: any outbound click from within a resource
      // article's CTA area toward a commercial destination.
      if (link.closest('.res-article-ctas')) {
        pushEvent('resource_cta_click', { link_url: href, link_text: link.textContent?.trim() });
      }
    }

    // Assessment start — both start buttons (#a-start-btn for the
    // comprehensive engine, #a-quick-start-btn for the free short
    // assessment) are created dynamically by their apps' innerHTML
    // render (and server-rendered on their pages), so this must be
    // delegated (checked at click time) rather than looked up once via
    // getElementById, which would race against that dynamic render and
    // silently never attach. ONE event family: the funnel parameters
    // distinguish the two — never separate event names.
    const startBtn = e.target instanceof Element
      ? e.target.closest('#a-start-btn, #a-quick-start-btn')
      : null;
    if (startBtn && !assessmentStartFired) {
      assessmentStartFired = true;
      const params = startBtn.id === 'a-quick-start-btn' ? freeStartParams : comprehensiveStartParams;
      // Still ONE push, still guarded by assessmentStartFired — the
      // campaign fields are added to the existing event, not a new one.
      pushEvent(assessmentStartEventName, withCampaign(params));
    }
  });
</script>
