---
// Site-wide attribution capture + Cal.com link enrichment.
// Included once in BaseLayout, alongside AnalyticsEvents. Three
// responsibilities:
//   1. Capture/persist first-touch and latest-touch attribution from
//      the current URL (src/lib/attribution.ts).
//   2. Capture/persist a sales-rep code from ?rep= / ?r=
//      (src/lib/repAttribution.ts) so every lead and booking in the
//      session is attributed to the rep who shared the link.
//   3. Rewrite the four centralized Cal.com scheduling links
//      (src/lib/scheduling.ts) so attribution — including the rep code
//      — travels with the click, without changing their destination
//      event, without breaking the existing booking_click_*
//      delegated-click tracking, and without ever appending an empty
//      parameter.
//
// This is a real module <script> (not is:inline), so it can import
// directly from the shared lib modules rather than duplicating logic.
---

<script>
  import { SCHEDULING } from '../lib/scheduling';
  import {
    captureAttribution,
    getCampaignAttribution,
    buildCalComForwardFields,
    appendAttributionToUrl,
  } from '../lib/attribution';
  import { captureRepAttribution, getRepCode, buildCalComRepField } from '../lib/repAttribution';

  try {
    captureAttribution();
  } catch {
    // captureAttribution() already catches internally; this is an extra
    // safety net so a truly unexpected error here can never break the
    // rest of the page.
  }

  try {
    captureRepAttribution();
  } catch {
    // Same defensive pattern — rep attribution must never break a page.
  }

  try {
    // Publish the session's campaign snapshot for the site-wide
    // delegated tracker in AnalyticsEvents.astro, which is an is:inline
    // script and therefore cannot import this module directly.
    //
    // Only the six UTM fields are exposed — never click IDs, never the
    // rep code, and never anything a visitor typed. The tracker reads
    // this lazily at click time, so the module/inline execution order
    // between the two components does not matter.
    (window as unknown as { yaiCampaign?: Record<string, string> }).yaiCampaign =
      getCampaignAttribution();

    // Same bridge for the business-card / QR rep code. Sanitized on
    // capture, so this is a short [a-z0-9._-] token and never PII.
    const repCode = getRepCode();
    if (repCode) {
      (window as unknown as { yaiRep?: string }).yaiRep = repCode;
    }
  } catch {
    // Analytics enrichment is best-effort; a storage-disabled browser
    // still gets the assessment events, just without campaign fields.
  }

  try {
    // Marketing attribution fields + the rep code (when one was
    // captured) both travel to Cal.com. Empty fields are never
    // appended by buildCalComForwardFields/buildCalComRepField.
    const forwardFields = {
      ...buildCalComForwardFields(),
      ...buildCalComRepField(),
    };
    const baseUrls = [
      SCHEDULING.strategyCall.url,
      SCHEDULING.enterpriseDiscussion.url,
      SCHEDULING.trainingConsultation.url,
      SCHEDULING.executiveAdvisory.url,
      SCHEDULING.comprehensiveAudit.url,
    ];

    if (Object.keys(forwardFields).length > 0) {
      const links = document.querySelectorAll('a[href]');
      links.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const matchedBase = baseUrls.find(
          (base) => href === base || href.startsWith(base + '?') || href.startsWith(base + '#')
        );
        if (matchedBase) {
          const enriched = appendAttributionToUrl(href, forwardFields);
          if (enriched !== href) {
            link.setAttribute('href', enriched);
          }
        }
      });
    }
  } catch {
    // Never let link enrichment break scheduling links themselves —
    // worst case, they simply stay as their original, fully-functional
    // bare Cal.com URL.
  }
</script>
