---
interface Props {
  steps: string[];
  tone?: 'muted' | 'accent' | 'accent-dark';
  /** 'vertical' stacks top-to-bottom at all widths (default).
   *  'horizontal' flows left-to-right on wider screens and stacks on mobile. */
  direction?: 'vertical' | 'horizontal';
  /** When true, the last step visually loops back toward the first (used
   *  for recurring/cyclical processes). Purely a visual affordance — no
   *  numbers, cadence, or outcomes are implied. */
  loop?: boolean;
}

const { steps, tone = 'muted', direction = 'vertical', loop = false } = Astro.props;
const arrow = direction === 'horizontal' ? '→' : '↓';
---

<ol class:list={['flow-chain', tone, direction]}>
  {steps.map((step, i) => (
    <li>
      <span class="flow-step">{step}</span>
      {i < steps.length - 1 && <span class="flow-arrow" aria-hidden="true">{arrow}</span>}
      {loop && i === steps.length - 1 && (
        <span class="flow-arrow flow-loop" aria-hidden="true" title="Repeats">
          <span class="flow-loop-icon">&#8635;</span> repeat
        </span>
      )}
    </li>
  ))}
</ol>

<style>
  .flow-chain {
    display: flex;
    flex-direction: column;
    align-items: center;
    list-style: none;
    padding: 0;
    gap: 4px;
  }

  .flow-chain li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .flow-step {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    max-width: 320px;
  }

  .flow-chain.muted .flow-step {
    background-color: var(--color-cloud-white);
    border: 1px solid var(--color-border-light);
    color: var(--color-slate-gray);
  }

  .flow-chain.accent .flow-step {
    background-color: rgba(37, 99, 235, 0.06);
    border: 1px solid rgba(37, 99, 235, 0.25);
    color: var(--color-near-black);
    font-weight: 700;
  }

  .flow-chain.accent-dark .flow-step {
    background-color: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.3);
    color: var(--color-pure-white);
    font-weight: 700;
  }

  .flow-chain.accent-dark .flow-arrow {
    color: var(--color-signal-cyan);
  }

  .flow-arrow {
    color: var(--color-electric-blue);
    font-size: 0.9rem;
    line-height: 1;
  }

  .flow-loop {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .flow-loop-icon {
    font-size: 1rem;
  }

  /* ---- Horizontal layout (desktop only) ----
     Only activates at a width wide enough that all steps guaranteed fit on
     one line (nowrap). Below this, the chain stays vertical — the
     always-safe layout — rather than risking an awkward wrap with a
     dangling arrow before the row break. */
  @media (min-width: 1300px) {
    .flow-chain.horizontal {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      flex-wrap: nowrap;
      gap: 0;
    }

    .flow-chain.horizontal li {
      flex-direction: row;
      align-items: center;
    }

    .flow-chain.horizontal .flow-step {
      max-width: none;
      white-space: nowrap;
      padding: 9px 14px;
      font-size: 0.78rem;
    }

    .flow-chain.horizontal .flow-arrow {
      margin-inline: 5px;
      flex-shrink: 0;
    }

    .flow-chain.horizontal .flow-loop {
      flex-direction: column;
      margin-inline-start: 8px;
      white-space: nowrap;
    }
  }
</style>
