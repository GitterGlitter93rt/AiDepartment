---
import Icon from '../Icon.astro';

interface Step {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
const desktopCols = steps.length <= 6 ? steps.length : steps.length <= 8 ? 4 : 3;
const singleRow = desktopCols === steps.length;
---

<div class="ps-wrap" style={`--ps-desktop-cols: ${desktopCols};`}>
  {singleRow && <span class="ps-connector" aria-hidden="true"></span>}
  <ol class="ps-steps">
    {steps.map((step, i) => (
      <li>
        <div class="ps-icon-wrap">
          <span class="ps-icon"><Icon name={step.icon} size={22} /></span>
          <span class="ps-number">{i + 1}</span>
        </div>
        <p class="ps-title">{step.title}</p>
        <p class="ps-desc">{step.description}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .ps-wrap {
    position: relative;
  }

  .ps-connector {
    display: none;
  }

  .ps-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 20px;
    list-style: none;
    padding: 0;
  }

  .ps-steps li {
    position: relative;
    text-align: center;
  }

  .ps-icon-wrap {
    position: relative;
    width: 68px;
    height: 68px;
    margin-inline: auto;
    margin-bottom: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border-dark);
    background-color: var(--color-deep-slate);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-signal-cyan);
  }

  .ps-number {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-electric-blue);
    color: var(--color-pure-white);
    border-radius: 50%;
    font-size: 0.68rem;
    font-weight: 700;
    border: 2px solid var(--color-midnight-navy);
  }

  .ps-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--color-pure-white);
    margin-bottom: 6px;
  }

  .ps-desc {
    font-size: 0.85rem;
    color: var(--color-dark-muted-text);
    line-height: 1.5;
    max-width: 220px;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .ps-steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .ps-steps {
      grid-template-columns: repeat(var(--ps-desktop-cols, 6), 1fr);
      gap: 14px;
    }

    .ps-connector {
      display: block;
      position: absolute;
      top: 34px;
      left: calc(50% / var(--ps-desktop-cols, 6));
      right: calc(50% / var(--ps-desktop-cols, 6));
      height: 1px;
      background-image: linear-gradient(to right, var(--color-border-dark) 0, var(--color-border-dark) 7px, transparent 7px, transparent 14px);
      background-size: 14px 1px;
      background-repeat: repeat-x;
      z-index: 0;
    }

    .ps-icon-wrap {
      position: relative;
      z-index: 1;
    }
  }
</style>
