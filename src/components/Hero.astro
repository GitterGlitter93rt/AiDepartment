---
import Container from './Container.astro';
import Button from './Button.astro';
import ScoreDashboard from './ScoreDashboard.astro';
import { PRIMARY_CTA, SECONDARY_CTA } from '../lib/site';
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg class="hero-grid" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <pattern id="hero-dot-grid" width="4" height="4" patternUnits="userSpaceOnUse">
          <circle cx="0.5" cy="0.5" r="0.35" fill="rgba(148,163,184,0.35)" />
        </pattern>
      </defs>
      <rect width="100" height="100" fill="url(#hero-dot-grid)" />
    </svg>
  </div>
  <Container wide class="hero-inner">
    <div class="hero-copy">
      <span class="eyebrow hero-eyebrow">Practical AI for Business</span>
      <h1 class="hero-headline">
        AI Consulting,<br /><span class="accent">Implementation &amp; Automation</span><br />for Real Business Value.
      </h1>
      <p class="hero-support">
        Your AI Department helps businesses plan, build, integrate, and manage practical AI
        systems — AI agents, workflow automation, CRM workflows, and marketing systems — that
        turn AI investment into faster lead response, stronger follow-up, and less repetitive work.
      </p>
      <p class="hero-support-secondary">
        We work as your external AI department: the strategy, implementation, and ongoing
        optimization of AI without having to build one in-house.
      </p>

      <div class="hero-ctas">
        <Button href={PRIMARY_CTA.href} variant="primary" size="large">{PRIMARY_CTA.label}</Button>
        <Button href={SECONDARY_CTA.href} variant="secondary-dark" size="large">{SECONDARY_CTA.label}</Button>
      </div>

      <p class="hero-support-copy">Free AI Department Assessment. Approximately 3–4 minutes.</p>
    </div>

    <div class="hero-visual">
      <ScoreDashboard />
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-midnight-navy);
    color: var(--color-pure-white);
    padding-block: 40px 44px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 12% 18%, rgba(37, 99, 235, 0.32), transparent 48%),
      radial-gradient(circle at 88% 6%, rgba(34, 211, 238, 0.22), transparent 42%),
      radial-gradient(circle at 60% 90%, rgba(37, 99, 235, 0.14), transparent 45%);
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), transparent 75%);
  }

  :global(.hero-inner) {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero-eyebrow {
    display: inline-block;
    color: var(--color-signal-cyan);
    background-color: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.25);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 16px;
    font-size: 0.72rem;
  }

  .hero-headline {
    font-size: var(--fs-h1);
    line-height: 1.14;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
  }

  .hero-headline .accent {
    background: linear-gradient(135deg, #5b9dff, var(--color-signal-cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-support {
    font-size: 0.85rem;
    color: var(--color-dark-muted-text);
    max-width: 440px;
    margin-bottom: 12px;
    line-height: 1.55;
  }

  .hero-support-secondary {
    font-size: 0.85rem;
    color: var(--color-slate-gray);
    max-width: 440px;
    margin-bottom: 18px;
    line-height: 1.55;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  .hero-support-copy {
    font-size: 0.8rem;
    color: var(--color-slate-gray);
  }

  .hero-visual {
    max-width: 100%;
    width: 100%;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .hero-visual {
      max-width: 540px;
    }
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: 36px;
    }

    :global(.hero-inner) {
      grid-template-columns: 0.88fr 1.12fr;
      gap: 44px;
    }

    .hero-visual {
      max-width: 100%;
      margin-inline: 0;
    }
  }
</style>
