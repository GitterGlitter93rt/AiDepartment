---
import '../styles/fonts.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AttributionCapture from '../components/AttributionCapture.astro';
import AnalyticsEvents from '../components/AnalyticsEvents.astro';
import MetaPixel from '../components/MetaPixel.astro';
import FunnelHeader from '../components/funnel/FunnelHeader.astro';
import FunnelFooter from '../components/funnel/FunnelFooter.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  /** Explicit robots directive (see SEO.astro). Used by the paid-social
   * funnels for "noindex, follow"; leave unset elsewhere. */
  robots?: string;
  /**
   * Page chrome. 'full' (default) is the normal marketing site: full
   * header with mega-menus and the full footer. 'minimal' is for
   * paid-social funnel landing pages, which get branding plus legal
   * links only — a visitor arriving from a video ad should choose
   * between reading on and taking the next step, not between twenty
   * navigation destinations. Everything else about the document (head,
   * GTM, attribution, analytics) is identical either way.
   */
  chrome?: 'full' | 'minimal';
  /** Include Organization + WebSite JSON-LD (typically only needed once, e.g. on the homepage) */
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  noindex,
  robots,
  chrome = 'full',
  includeOrgSchema = false,
} = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.domain,
  description: SITE.defaultDescription,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.domain,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Central favicon system (Part: favicon/brand pass) — the compact
        YAD circular mark: navy tile, electric-blue→cyan gradient ring,
        bold YAD monogram. All pages inherit these from BaseLayout; do
        not add per-page icon links. Apple touch icon is the opaque
        square variant (iOS applies its own rounding). */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#08111F" />
    <meta name="generator" content={Astro.generator} />

    <SEO title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} robots={robots} />

    {/* Google Tag Manager — approved container GTM-5G8Q7KKZ (Sprint 9).
        GA4 (G-GLSRPH43L4) is managed through this container, not loaded
        separately, to avoid a duplicate/redundant gtag.js snippet. */}
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5G8Q7KKZ');
    </script>

    {/* Meta Pixel integration point. Renders nothing until
        PUBLIC_META_PIXEL_ID is set in the build environment — no Meta
        code ships today and no placeholder ID exists. See
        src/lib/metaPixel.ts. */}
    <MetaPixel />

    {includeOrgSchema && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
        <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
      </>
    )}
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5G8Q7KKZ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {chrome === 'minimal' ? <FunnelHeader /> : <Header />}
    <main id="main-content">
      <slot />
    </main>
    {chrome === 'minimal' ? <FunnelFooter /> : <Footer />}
    <AttributionCapture />
    <AnalyticsEvents />
  </body>
</html>
