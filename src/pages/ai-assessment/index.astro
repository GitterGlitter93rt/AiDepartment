---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free AI Department Assessment for Business | Your AI Department"
  description="Take the free AI Department Assessment to identify opportunities for AI, automation, employee productivity, marketing, sales, customer service, and business growth."
  path="/ai-assessment/"
>
  <section class="assessment-page">
    <div id="assessment-root" class="a-shell-mount">
      {/*
        Server-rendered initial state, matching exactly what
        assessmentApp.ts's renderIntro() produces for the 'intro' state
        (the app's default starting state on every load). This ensures a
        real, visible H1 exists in the server-rendered HTML for crawlers
        and non-JS clients, and removes the blank-page flash before JS
        mounts. mountAssessmentApp() overwrites this innerHTML with
        functionally identical markup and its own event listeners the
        instant it initializes, so this is purely a progressive-enhancement
        starting point — not a duplicate UI a user would ever actually see
        both versions of.
      */}
      <div class="a-intro">
        <span class="a-eyebrow">AI Department Assessment</span>
        <h1>Find Out Where AI Can Actually Improve Your Business.</h1>
        <p class="a-intro-copy">
          In approximately 7-12 minutes, this assessment evaluates key areas of your business
          and produces your AI Department Score with personalized opportunity recommendations.
        </p>
        <ul class="a-intro-facts">
          <li>Free — no cost to complete</li>
          <li>7-12 minutes for most companies</li>
          <li>Deterministic scoring — not a generic quiz</li>
        </ul>
        <button type="button" class="a-btn a-btn-primary a-btn-large" id="a-start-btn">Start Assessment</button>
        <p class="a-intro-legal">
          By starting, you agree to our <a href="/privacy/">Privacy Policy</a> and
          <a href="/terms/">Terms of Use</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountAssessmentApp } from '../../components/assessment/assessmentApp';

  const root = document.getElementById('assessment-root');
  if (root) {
    mountAssessmentApp(root);
  }
</script>

<style>
  /* Active-assessment focus mode: hide the full marketing footer so the
     question flow feels like a focused application rather than a page with
     a long footer underneath it. Toggled by assessmentApp.ts; only ever
     applied while this page's script is running, so it cannot affect the
     homepage or any other route. */
  :global(body.assessment-active footer.site-footer) {
    display: none;
  }

  .assessment-page {
    background-color: var(--color-midnight-navy);
    min-height: 70vh;
    padding-block: 24px 56px;
  }

  .a-shell-mount {
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  /* ---------------- Intro ---------------- */
  :global(.a-intro) {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    color: var(--color-pure-white);
    padding-block: 48px;
  }

  :global(.a-intro h1) {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.15;
    font-weight: 800;
    margin-block: 16px 16px;
  }

  :global(.a-intro-copy) {
    color: var(--color-dark-muted-text);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  :global(.a-intro-facts) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    list-style: none;
    padding: 0;
    margin-bottom: 32px;
    color: var(--color-dark-muted-text);
    font-size: 0.9rem;
  }

  :global(.a-intro-legal) {
    margin-top: 16px;
    font-size: 0.8rem;
    color: var(--color-slate-gray);
  }

  :global(.a-intro-legal a) {
    color: var(--color-signal-cyan);
    text-decoration: underline;
  }

  /* ---------------- Shared controls ---------------- */
  :global(.a-eyebrow) {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-signal-cyan);
  }

  :global(.a-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 12px 22px;
    border-radius: var(--radius-button);
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  :global(.a-btn-large) { padding: 14px 28px; font-size: 0.95rem; }

  :global(.a-btn-primary) { background-color: var(--color-electric-blue); color: var(--color-pure-white); }
  :global(.a-btn-primary:hover) { background-color: var(--color-electric-blue-hover); }
  :global(.a-btn-primary:disabled) { opacity: 0.5; cursor: not-allowed; }

  :global(.a-btn-secondary) { background-color: transparent; border-color: var(--color-border-dark); color: var(--color-pure-white); }
  :global(.a-btn-secondary:disabled) { opacity: 0.4; cursor: not-allowed; }

  :global(.a-error) {
    color: #fca5a5;
    background-color: rgba(220, 38, 38, 0.12);
    border: 1px solid rgba(220, 38, 38, 0.35);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }

  /* ---------------- Question shell layout ---------------- */
  :global(.a-shell) {
    color: var(--color-pure-white);
  }

  :global(.a-topbar) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background-color: var(--color-deep-slate);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-panel);
    padding: 18px 20px;
    margin-bottom: 16px;
  }

  :global(.a-topbar-sub) {
    font-size: 0.78rem;
    color: var(--color-dark-muted-text);
    margin-top: 4px;
  }

  :global(.a-topbar-progress) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    color: var(--color-dark-muted-text);
  }

  :global(.a-progress-track) {
    flex: 1;
    height: 6px;
    background-color: rgba(148, 163, 184, 0.2);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  :global(.a-progress-hint) {
    font-size: 0.68rem;
    color: var(--color-slate-gray);
    flex-basis: 100%;
  }

  :global(.a-progress-fill) {
    height: 100%;
    background: var(--gradient-primary);
    border-radius: var(--radius-pill);
    transition: width var(--transition-base);
  }

  :global(.a-body) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  :global(.a-sidebar) {
    display: none;
  }

  :global(.a-question-card) {
    background-color: var(--color-deep-slate);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-panel);
    padding: 24px 22px;
  }

  :global(.a-question-meta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    font-size: 0.75rem;
  }

  :global(.a-section-tag) {
    color: var(--color-signal-cyan);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(.a-question-count) {
    color: var(--color-slate-gray);
  }

  :global(.a-question-prompt) {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 8px;
  }

  :global(.a-question-help) {
    color: var(--color-dark-muted-text);
    font-size: 0.85rem;
    margin-bottom: 16px;
  }

  :global(.a-answer-area) {
    margin-top: 16px;
  }

  :global(.a-max-note) {
    font-size: 0.78rem;
    color: var(--color-slate-gray);
    margin-bottom: 10px;
  }

  :global(.a-options) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.a-option) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid var(--color-border-dark);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  :global(.a-option:hover) {
    border-color: rgba(37, 99, 235, 0.5);
  }

  :global(.a-option:focus-within) {
    outline: 2px solid var(--color-signal-cyan);
    outline-offset: 2px;
  }

  :global(.a-option.is-selected) {
    border-color: var(--color-electric-blue);
    background-color: rgba(37, 99, 235, 0.12);
  }

  :global(.a-option input) {
    width: 18px;
    height: 18px;
    accent-color: var(--color-electric-blue);
    flex-shrink: 0;
  }

  :global(.a-option-label) {
    font-size: 0.92rem;
    line-height: 1.4;
  }

  :global(.a-select-wrap) {
    display: flex;
  }

  :global(.a-select-wrap select) {
    width: 100%;
    padding: 14px 16px;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--color-pure-white);
    background-color: var(--color-deep-slate);
    border: 1px solid var(--color-border-dark);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color var(--transition-fast);
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%2394A3B8' stroke-width='2.5'><path d='M6 9l6 6 6-6'/></svg>");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 44px;
  }

  :global(.a-select-wrap select:hover) {
    border-color: rgba(37, 99, 235, 0.5);
  }

  :global(.a-select-wrap select:focus-visible) {
    outline: 2px solid var(--color-signal-cyan);
    outline-offset: 2px;
  }

  :global(.a-select-wrap select optgroup) {
    background-color: var(--color-pure-white);
    color: var(--color-near-black);
    font-weight: 700;
  }

  :global(.a-select-wrap select option) {
    /* The closed <select> is intentionally dark-themed (matches the
       rest of the assessment), but its OPEN native dropdown popup is
       a separate rendering surface in most browsers — without an
       explicit background here, options can inherit the select's own
       dark background while keeping this dark text color, making them
       nearly unreadable. Setting an explicit light background
       guarantees contrast with the dark text below, independent of
       what the browser would otherwise default to. */
    background-color: var(--color-pure-white);
    color: var(--color-near-black);
    font-weight: 400;
  }

  :global(.a-answer-area textarea) {
    width: 100%;
    background-color: var(--color-midnight-navy);
    border: 1px solid var(--color-border-dark);
    border-radius: 10px;
    color: var(--color-pure-white);
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 12px 14px;
    resize: vertical;
  }

  :global(.a-nav-controls) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }

  :global(.a-scorebar) {
    display: none;
  }

  /* ---------------- Section nav (desktop) ---------------- */
  :global(.a-section-nav-item) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border-dark);
    color: var(--color-pure-white);
    padding: 12px 14px;
    cursor: pointer;
    position: relative;
  }

  :global(.a-section-nav-item.is-active) {
    background-color: rgba(37, 99, 235, 0.14);
    border-left: 3px solid var(--color-electric-blue);
  }

  :global(.a-section-nav-label) {
    font-weight: 700;
    font-size: 0.85rem;
  }

  :global(.a-section-nav-sub) {
    font-size: 0.72rem;
    color: var(--color-dark-muted-text);
  }

  :global(.a-section-nav-count) {
    position: absolute;
    top: 12px;
    right: 14px;
    font-size: 0.72rem;
    color: var(--color-slate-gray);
  }

  /* ---------------- Score preview ---------------- */
  :global(.a-scorebar h3) {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-dark-muted-text);
    margin-bottom: 16px;
  }

  :global(.a-score-ring-wrap) {
    text-align: center;
    margin-bottom: 16px;
  }

  :global(.a-score-number) {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 800;
  }

  :global(.a-score-stage) {
    font-size: 0.8rem;
    color: var(--color-signal-cyan);
    font-weight: 700;
  }

  :global(.a-score-categories) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.78rem;
  }

  :global(.a-score-categories li) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.a-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-signal-cyan);
    flex-shrink: 0;
  }

  :global(.a-cat-label) {
    flex: 1;
    color: var(--color-dark-muted-text);
  }

  :global(.a-cat-val) {
    font-weight: 700;
  }

  :global(.a-scorebar-note) {
    font-size: 0.78rem;
    color: var(--color-slate-gray);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  :global(.a-trust-note) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--color-dark-muted-text);
    border-top: 1px solid var(--color-border-dark);
    padding-top: 12px;
  }

  /* ---------------- Contact capture ---------------- */
  :global(.a-contact) {
    max-width: 560px;
    margin-inline: auto;
    background-color: var(--color-deep-slate);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-panel);
    padding: 28px 24px;
    color: var(--color-pure-white);
  }

  :global(.a-contact h2) {
    font-size: 1.3rem;
    line-height: 1.4;
    margin-block: 10px 20px;
  }

  :global(.a-field-row) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  :global(.a-field) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
    font-size: 0.82rem;
    color: var(--color-dark-muted-text);
  }

  :global(.a-field input) {
    background-color: var(--color-midnight-navy);
    border: 1px solid var(--color-border-dark);
    border-radius: 8px;
    color: var(--color-pure-white);
    padding: 10px 12px;
    font-size: 0.92rem;
  }

  :global(.a-checkbox) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.78rem;
    color: var(--color-dark-muted-text);
    margin-bottom: 14px;
    line-height: 1.5;
  }

  :global(.a-checkbox input) {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    accent-color: var(--color-electric-blue);
  }

  :global(.a-checkbox a) {
    color: var(--color-signal-cyan);
  }

  /* ---------------- Submitting ---------------- */
  :global(.a-submitting) {
    text-align: center;
    color: var(--color-pure-white);
    padding-block: 64px;
  }

  :global(.a-spinner) {
    width: 32px;
    height: 32px;
    border: 3px solid var(--color-border-dark);
    border-top-color: var(--color-signal-cyan);
    border-radius: 50%;
    margin-inline: auto;
    margin-bottom: 16px;
    animation: a-spin 0.8s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.a-spinner) { animation: none; }
    :global(.a-progress-fill) { transition: none; }
  }

  @keyframes a-spin {
    to { transform: rotate(360deg); }
  }

  /* ---------------- Mobile-only density tightening ---------------- */
  /* Real-device QA (iPhone Safari) found the question card and answer
     options too tall on phones, particularly for long option lists like
     Q1 (Industry, 16 options). Tighten padding/gaps here only — desktop
     (min-width: 1024px) below is untouched. Touch targets stay >=44px. */
  @media (max-width: 767px) {
    :global(.a-topbar) {
      padding: 14px 16px;
      gap: 10px;
    }

    :global(.a-topbar-sub) {
      font-size: 0.72rem;
    }

    :global(.a-question-card) {
      padding: 16px 14px;
    }

    :global(.a-question-meta) {
      margin-bottom: 10px;
    }

    :global(.a-question-prompt) {
      font-size: 1.05rem;
      line-height: 1.3;
      margin-bottom: 6px;
    }

    :global(.a-question-help) {
      margin-bottom: 10px;
    }

    :global(.a-answer-area) {
      margin-top: 10px;
    }

    :global(.a-options) {
      gap: 8px;
    }

    :global(.a-option) {
      padding: 13px 14px;
      border-radius: 9px;
    }

    :global(.a-option-label) {
      font-size: 0.88rem;
    }

    :global(.a-nav-controls) {
      margin-top: 12px;
    }
  }

  /* ---------------- Desktop three-column layout ---------------- */
  @media (min-width: 1024px) {
    :global(.a-body) {
      grid-template-columns: 260px 1fr 280px;
      align-items: start;
    }

    :global(.a-sidebar) {
      display: block;
      background-color: var(--color-deep-slate);
      border: 1px solid var(--color-border-dark);
      border-radius: var(--radius-panel);
      overflow: hidden;
      position: sticky;
      top: 16px;
    }

    :global(.a-scorebar) {
      display: block;
      background-color: var(--color-deep-slate);
      border: 1px solid var(--color-border-dark);
      border-radius: var(--radius-panel);
      padding: 20px;
      position: sticky;
      top: 16px;
    }

    :global(.a-topbar) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    :global(.a-topbar-progress) {
      min-width: 260px;
    }
  }
</style>
