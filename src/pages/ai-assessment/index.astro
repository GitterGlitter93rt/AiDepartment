---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Department Assessment — Choose Your Assessment | Your AI Department"
  description="Two ways to assess your business: the free 3-4 minute AI Opportunity Assessment for a fast score, or the $495 Comprehensive AI Business Audit for a deeper diagnostic."
  path="/ai-assessment/"
>
  {/*
    LEGACY COMPATIBILITY / CHOICE PAGE.

    This route previously served the assessment application directly.
    Existing email links, ads, and external references must keep
    resolving, so it deliberately does NOT auto-redirect. Instead it
    presents the two current options:

      PRIMARY:   Free AI Opportunity Assessment  -> /free-ai-assessment/
      SECONDARY: Comprehensive AI Business Audit -> /comprehensive-ai-business-audit/

    The short free assessment itself lives at /free-ai-assessment/
    (canonical, indexable). The 64-question comprehensive engine lives
    at /ai-assessment/full/ (the underlying engine, deliberately
    noindex and NOT publicly promoted — it must not be offered as a
    free alternative to the $495 audit). This page is indexable with
    unique choice-page content and canonicals to itself, so it creates
    no duplicate-content problem with either destination.
  */}
  <section class="choice-page">
    <div class="choice-shell">
      <div class="choice-header">
        <span class="choice-eyebrow">AI Department Assessment</span>
        <h1>Choose Your Assessment</h1>
        <p class="choice-support">
          Start free in a few minutes — or go deeper with the $495 Comprehensive AI Business Audit.
        </p>
      </div>

      <div class="choice-cards">
        <a class="choice-card choice-card-primary" href="/free-ai-assessment/">
          <span class="choice-tag">Free &bull; 3-4 Minutes</span>
          <h2>Free AI Opportunity Assessment</h2>
          <p>
            Answer 15 quick questions and get your AI Department Score, category breakdown,
            and biggest AI, automation, and growth opportunities. Free — no cost, no commitment.
          </p>
          <ul class="choice-facts">
            <li>15 questions, about 3-4 minutes</li>
            <li>Score, category breakdown, and top opportunities</li>
            <li>Free — results in minutes</li>
          </ul>
          <span class="choice-cta">Start the Free Assessment &rarr;</span>
        </a>

        <a class="choice-card" href="/comprehensive-ai-business-audit/">
          <span class="choice-tag choice-tag-paid">$495 &bull; Deeper Diagnostic</span>
          <h2>Comprehensive AI Business Audit</h2>
          <p>
            A fixed-price $495 deeper diagnostic across your AI readiness, marketing and lead
            flow, sales follow-up, customer communication, operational automation, and AI
            agents and integrations — with ROI and financial-impact scenarios where your
            data supports them.
          </p>
          <ul class="choice-facts">
            <li>Personalized audit report and priorities</li>
            <li>45-minute strategy review call</li>
            <li>Standalone — no further commitment</li>
          </ul>
          <span class="choice-cta">Explore the $495 Audit &rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .choice-page {
    background-color: var(--color-midnight-navy);
    min-height: 70vh;
    padding-block: 48px 64px;
    color: var(--color-pure-white);
  }

  .choice-shell {
    max-width: 960px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .choice-header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: 40px;
  }

  .choice-eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-signal-cyan);
  }

  .choice-header h1 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    line-height: 1.15;
    font-weight: 800;
    margin-block: 14px 14px;
  }

  .choice-support {
    color: var(--color-dark-muted-text);
    font-size: 1rem;
    line-height: 1.6;
  }

  .choice-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .choice-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    text-decoration: none;
    color: var(--color-pure-white);
    background-color: var(--color-deep-slate);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-panel);
    padding: 28px 26px;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .choice-card:hover {
    border-color: rgba(37, 99, 235, 0.6);
  }

  .choice-card:focus-visible {
    outline: 2px solid var(--color-signal-cyan);
    outline-offset: 2px;
  }

  .choice-card-primary {
    border-color: var(--color-electric-blue);
    background:
      linear-gradient(rgba(37, 99, 235, 0.14), rgba(37, 99, 235, 0.14)),
      var(--color-deep-slate);
  }

  .choice-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-signal-cyan);
    margin-bottom: 4px;
  }

  .choice-tag-paid {
    color: var(--color-dark-muted-text);
  }

  .choice-card h2 {
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: 6px;
  }

  .choice-card p {
    font-size: 0.92rem;
    color: var(--color-dark-muted-text);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .choice-facts {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--color-dark-muted-text);
  }

  .choice-facts li::before {
    content: '\2713';
    color: var(--color-signal-cyan);
    font-weight: 700;
    margin-right: 10px;
  }

  .choice-cta {
    margin-top: auto;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-signal-cyan);
  }

  .choice-card-primary .choice-cta {
    color: var(--color-pure-white);
  }

  @media (min-width: 768px) {
    .choice-cards {
      grid-template-columns: 1fr 1fr;
    }

    .choice-card {
      min-height: 380px;
    }
  }
</style>
