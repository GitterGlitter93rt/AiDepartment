---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import InteriorHero from '../../components/interior/InteriorHero.astro';
import SectionHeading from '../../components/interior/SectionHeading.astro';
import FAQSection from '../../components/interior/FAQSection.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { SCHEDULING } from '../../lib/scheduling';

// PERMANENT public route for the paid offer. The previous route
// (/ai-department-audit/) is a redirect in astro.config.mjs — it must
// not exist as a duplicate indexable page.
//
// PURCHASE PATH: booking and the required $495 payment are handled by
// Cal.com (SCHEDULING.comprehensiveAudit). This page never processes or
// simulates payment.
//
// INTERNAL ACCESS NOTE: post-payment access delivery is NOT automated.
// Cal.com does not automatically grant access to the underlying
// comprehensive engine (/ai-assessment/full/), and this page must not
// link to it. Comprehensive-assessment instructions are sent to the
// buyer after booking; the engine route stays internal and unlisted
// until post-payment access delivery is implemented.

// Single source of truth for the price label: the centralized
// scheduling configuration.
const AUDIT_PRICE_LABEL = SCHEDULING.comprehensiveAudit.price;
const AUDIT_BOOKING_URL = SCHEDULING.comprehensiveAudit.url;

const includesItems = [
  {
    icon: 'search',
    title: 'Intake and Discovery',
    description: 'A structured intake questionnaire covering your goals, current marketing, lead flow, sales follow-up, operations, and existing AI usage.',
  },
  {
    icon: 'clipboard-list',
    title: 'Multi-Area Audit Analysis',
    description: 'Your responses and the information you share — website, marketing and tracking setup, lead and sales process, and systems — analyzed across every audit area.',
  },
  {
    icon: 'file-text',
    title: 'Personalized Audit Report',
    description: 'A personalized report of your comprehensive audit findings, with your highest-value AI, automation, and systems opportunities identified.',
  },
  {
    icon: 'list-checks',
    title: 'Priorities and Strategy Review',
    description: 'Prioritized AI opportunities and implementation priorities, walked through with you on a 45-minute strategy review call.',
  },
];

const steps = [
  {
    icon: 'credit-card',
    title: '1. Book and Pay',
    description: 'Book your audit through Cal.com. The required $495 payment is processed securely at booking through Cal.com — not on this website.',
  },
  {
    icon: 'send',
    title: '2. Complete Your Assessment',
    description: 'After booking, you receive instructions to complete the comprehensive business assessment that powers your audit.',
  },
  {
    icon: 'file-check-2',
    title: '3. Strategy Review',
    description: 'Your personalized audit report and prioritized AI opportunities, reviewed with you on your 45-minute strategy review call.',
  },
];

const faqs = [
  {
    question: 'Why is the audit paid when the assessment is free?',
    answer: 'The AI Opportunity Assessment is a free self-diagnostic — your answers scored against a fixed model. The Comprehensive AI Business Audit is a deeper, structured audit across your AI readiness, marketing and lead flow, sales follow-up, customer communication, operational automation, and AI agents and integrations — including financial-impact scenarios where your data supports them, a personalized audit report, and a 45-minute strategy review call. That deeper scope is why it carries a fixed price.',
  },
  {
    question: 'What happens after I book?',
    answer: 'Booking and the required $495 payment are handled through Cal.com. After booking, you receive instructions to complete the comprehensive business assessment that powers your audit, and your 45-minute strategy review is scheduled for your booked time.',
  },
  {
    question: 'Should I take the free assessment first?',
    answer: 'It helps but it is not required. If you have taken the free AI Opportunity Assessment, we can use your results as a starting point for the audit. If not, the audit intake covers what we need.',
  },
  {
    question: 'Is the audit a commitment to work with you?',
    answer: 'No. The audit is a standalone deliverable. The report is yours to act on however you choose — implement the recommendations yourself, take them anywhere else, or engage us for strategy or implementation if that makes sense.',
  },
];
---

<BaseLayout
  title={`Comprehensive AI Business Audit — ${AUDIT_PRICE_LABEL} | Your AI Department`}
  description="A $495 fixed-price deeper diagnostic across AI readiness, marketing, sales follow-up, and operations — with a personalized audit report and a 45-minute strategy review."
  path="/comprehensive-ai-business-audit/"
>
  {/*
    NOTE ON PAYMENT: this page intentionally does NOT process or
    simulate payment. Booking and the required $495 payment are handled
    by Cal.com (SCHEDULING.comprehensiveAudit). The booking links below
    receive attribution enrichment and GA4 booking-click tracking via
    the site-wide AttributionCapture / AnalyticsEvents architecture.
  */}
  <InteriorHero
    eyebrow="Paid Audit — Fixed Price"
    headline={`Comprehensive AI Business Audit — ${AUDIT_PRICE_LABEL}`}
    support="A deeper diagnostic across your AI readiness, marketing and lead flow, sales follow-up, customer communication, operational automation, and AI agents and integrations. You receive a personalized audit report, prioritized AI opportunities, financial-impact scenarios where your data supports them, and a 45-minute strategy review call."
    primaryCta={{ label: `Book Your ${AUDIT_PRICE_LABEL} Comprehensive AI Business Audit`, href: AUDIT_BOOKING_URL }}
    secondaryCta={{ label: 'Take the Free Assessment First', href: '/free-ai-assessment/' }}
    supportCopy={`Your ${AUDIT_PRICE_LABEL} audit includes a 45-minute strategy review. Booking and the required payment are handled through Cal.com — not on this website.`}
  />

  <Section tone="light">
    <Container>
      <SectionHeading
        eyebrow="What You Receive"
        heading="A Real Diagnostic, Not a Sales Pitch"
        support="The audit examines where your business is actually losing leads, time, and money — and where AI, automation, and better systems would create the most value."
      />
      <div class="audit-grid">
        {includesItems.map((item) => (
          <div class="audit-card">
            <span class="audit-icon"><Icon name={item.icon} size={22} /></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="white">
    <Container>
      <SectionHeading
        eyebrow="How It Works"
        heading="Book and Pay — Complete Your Assessment — Strategy Review"
        support="Booking and payment happen through Cal.com. After booking, you complete the comprehensive business assessment that powers your audit."
      />
      <div class="audit-steps">
        {steps.map((step) => (
          <div class="audit-step">
            <span class="audit-step-icon"><Icon name={step.icon} size={22} /></span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="light">
    <Container>
      <SectionHeading
        eyebrow="Book Your Audit"
        heading={`Book Your ${AUDIT_PRICE_LABEL} Comprehensive AI Business Audit`}
        support={`Your ${AUDIT_PRICE_LABEL} audit includes a 45-minute strategy review. Booking and the required payment are handled securely through Cal.com.`}
      />
      <div class="audit-booking">
        <div class="audit-booking-card">
          <p class="audit-booking-copy">
            After booking, you'll receive instructions to complete the comprehensive business
            assessment that powers your audit &mdash; then your personalized audit report and
            prioritized AI opportunities are reviewed with you on your 45-minute strategy review call.
          </p>
          <Button href={AUDIT_BOOKING_URL} variant="primary" size="large">Book Your {AUDIT_PRICE_LABEL} Comprehensive AI Business Audit</Button>
          <p class="audit-booking-note">
            45 minutes &bull; {AUDIT_PRICE_LABEL} &bull; Booking and payment are processed by Cal.com &mdash; not on this website.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="light">
    <Container>
      <SectionHeading
        eyebrow="Common Questions"
        heading="Comprehensive AI Business Audit FAQ"
      />
      <FAQSection items={faqs} />
    </Container>
  </Section>
</BaseLayout>


<style>
  .audit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .audit-card {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-card);
    padding: 22px;
    box-shadow: var(--shadow-card-light);
  }

  .audit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgba(37, 99, 235, 0.1);
    color: var(--color-electric-blue);
    margin-bottom: 14px;
  }

  .audit-card h3 {
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .audit-card p {
    font-size: 0.9rem;
    color: var(--color-slate-gray);
    line-height: 1.6;
  }

  .audit-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .audit-step {
    background-color: var(--color-cloud-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-card);
    padding: 22px;
  }

  .audit-step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgba(37, 99, 235, 0.1);
    color: var(--color-electric-blue);
    margin-bottom: 14px;
  }

  .audit-step h3 {
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .audit-step p {
    font-size: 0.9rem;
    color: var(--color-slate-gray);
    line-height: 1.6;
  }

  /* ---------------- Booking section (Cal.com handles booking + payment) */
  .audit-booking {
    max-width: 720px;
    margin-inline: auto;
  }

  .audit-booking-card {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-card);
    padding: 32px;
    box-shadow: var(--shadow-card-light);
    text-align: center;
  }

  .audit-booking-copy {
    font-size: 0.95rem;
    color: var(--color-slate-gray);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .audit-booking-note {
    margin-top: 16px;
    font-size: 0.78rem;
    color: var(--color-slate-gray);
  }

  @media (min-width: 768px) {
    .audit-grid,
    .audit-steps {
      grid-template-columns: 1fr 1fr;
    }

    .audit-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
