---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import CTABand from '../../components/interior/CTABand.astro';
import { PRIMARY_CTA, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const relatedEntries = await Promise.all(
  entry.data.relatedResources.map((slug: string) => getEntry('resources', slug))
);
const validRelated = relatedEntries.filter((r): r is NonNullable<typeof r> => Boolean(r));

const canonicalPath = `/resources/${entry.id}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishDate,
  dateModified: entry.data.updatedDate || entry.data.publishDate,
  author: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
  },
  mainEntityOfPage: new URL(canonicalPath, SITE.domain).toString(),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', SITE.domain).toString() },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: new URL(canonicalPath, SITE.domain).toString() },
  ],
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.description}
  path={canonicalPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <Section tone="light">
    <Container>
      <nav class="res-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/resources/">Resources</a> <span aria-hidden="true">/</span> <span aria-current="page">{entry.data.title}</span>
      </nav>
      <span class="eyebrow res-article-eyebrow">Resource</span>
      <h1 class="res-article-h1">{entry.data.title}</h1>
      <p class="res-article-desc">{entry.data.description}</p>

      <div class="res-article-body">
        <Content />
      </div>

      <div class="res-article-ctas">
        <Button href={entry.data.primaryDestination.href} variant="primary" size="large">{entry.data.primaryDestination.label}</Button>
        {entry.data.secondaryDestinations.length > 0 && (
          <div class="res-secondary-links">
            {entry.data.secondaryDestinations.map((dest: { label: string; href: string }) => (
              <a href={dest.href}>{dest.label} &rarr;</a>
            ))}
          </div>
        )}
      </div>
    </Container>
  </Section>

  {validRelated.length > 0 && (
    <Section tone="white">
      <Container>
        <h2 class="res-related-h2">Related Resources</h2>
        <div class="res-related-grid">
          {validRelated.map((related) => (
            <a href={`/resources/${related.id}/`} class="res-related-card">
              <h3>{related.data.title}</h3>
              <p>{related.data.description}</p>
            </a>
          ))}
        </div>
      </Container>
    </Section>
  )}

  <CTABand
    icon="clipboard-check"
    heading="Find Out Where AI Can Create Value in Your Business"
    support="Take the free AI Department Assessment and receive your initial AI Department Score and opportunity analysis."
    primaryCta={PRIMARY_CTA}
    microcopy="Free • 7-12 Minutes • No Commitment"
  />
</BaseLayout>

<style>
  .res-breadcrumb {
    font-size: 0.8rem;
    color: var(--color-slate-gray);
    margin-bottom: 20px;
  }

  .res-breadcrumb a {
    color: var(--color-slate-gray);
  }

  .res-breadcrumb a:hover {
    color: var(--color-electric-blue);
  }

  .res-breadcrumb span[aria-current] {
    color: var(--color-near-black);
    font-weight: 600;
  }

  .res-article-eyebrow {
    color: var(--color-electric-blue);
    display: inline-block;
    margin-bottom: 12px;
  }

  .res-article-h1 {
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.15;
    max-width: 780px;
    margin-bottom: 16px;
  }

  .res-article-desc {
    font-size: 1.05rem;
    color: var(--color-slate-gray);
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 40px;
  }

  .res-article-body {
    max-width: 720px;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-near-black);
  }

  .res-article-body :global(h2) {
    font-size: 1.4rem;
    font-weight: 800;
    margin-block: 40px 16px;
  }

  .res-article-body :global(p) {
    margin-bottom: 18px;
    color: var(--color-slate-gray);
  }

  .res-article-body :global(strong) {
    color: var(--color-near-black);
  }

  .res-article-body :global(a) {
    color: var(--color-electric-blue);
    font-weight: 600;
  }

  .res-article-body :global(ul),
  .res-article-body :global(ol) {
    margin-bottom: 18px;
    padding-left: 24px;
    color: var(--color-slate-gray);
  }

  .res-article-body :global(li) {
    margin-bottom: 6px;
  }

  .res-article-ctas {
    max-width: 720px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-light);
  }

  .res-secondary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 16px;
  }

  .res-secondary-links a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-slate-gray);
  }

  .res-secondary-links a:hover {
    color: var(--color-electric-blue);
  }

  .res-related-h2 {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 24px;
    text-align: center;
  }

  .res-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 900px;
    margin-inline: auto;
  }

  .res-related-card {
    display: block;
    background-color: var(--color-cloud-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-panel);
    padding: 20px 18px;
  }

  .res-related-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--color-near-black);
  }

  .res-related-card p {
    font-size: 0.85rem;
    color: var(--color-slate-gray);
    line-height: 1.5;
  }

  @media (min-width: 700px) {
    .res-related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
