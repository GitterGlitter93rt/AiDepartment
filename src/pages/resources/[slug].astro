---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import CTABand from '../../components/interior/CTABand.astro';
import { PRIMARY_CTA, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const relatedEntries = await Promise.all(
  entry.data.relatedResources.map((slug: string) => getEntry('resources', slug))
);
const validRelated = relatedEntries.filter((r): r is NonNullable<typeof r> => Boolean(r));

const canonicalPath = `/resources/${entry.id}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishDate,
  dateModified: entry.data.updatedDate || entry.data.publishDate,
  author: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
  },
  mainEntityOfPage: new URL(canonicalPath, SITE.domain).toString(),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', SITE.domain).toString() },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: new URL(canonicalPath, SITE.domain).toString() },
  ],
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.description}
  path={canonicalPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <Section tone="light">
    <Container>
      <div class="resource-header">
        <nav class="res-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/resources/">Resources</a> <span aria-hidden="true">/</span> <span aria-current="page">{entry.data.title}</span>
        </nav>
        <span class="eyebrow res-article-eyebrow">Resource</span>
        <h1 class="res-article-h1">{entry.data.title}</h1>
        <p class="res-article-desc">{entry.data.description}</p>
      </div>

      <div class="res-article-body">
        <Content />
      </div>

      <div class="res-article-ctas">
        <Button href={entry.data.primaryDestination.href} variant="primary" size="large">{entry.data.primaryDestination.label}</Button>
        {entry.data.secondaryDestinations.length > 0 && (
          <div class="res-secondary-links">
            {entry.data.secondaryDestinations.map((dest: { label: string; href: string }) => (
              <a href={dest.href}>{dest.label} &rarr;</a>
            ))}
          </div>
        )}
      </div>
    </Container>
  </Section>

  {validRelated.length > 0 && (
    <Section tone="white">
      <Container>
        <h2 class="res-related-h2">Related Resources</h2>
        <div class="res-related-grid">
          {validRelated.map((related) => (
            <a href={`/resources/${related.id}/`} class="res-related-card">
              <h3>{related.data.title}</h3>
              <p>{related.data.description}</p>
            </a>
          ))}
        </div>
      </Container>
    </Section>
  )}

  <CTABand
    icon="clipboard-check"
    heading="Find Out Where AI Can Create Value in Your Business"
    support="Take the free AI Department Assessment and receive your initial AI Department Score and opportunity analysis."
    primaryCta={PRIMARY_CTA}
    microcopy="Free • 7-12 Minutes • No Commitment"
  />
</BaseLayout>

<style>
  .res-breadcrumb {
    font-size: 0.8rem;
    color: var(--color-slate-gray);
    margin-bottom: 20px;
  }

  .res-breadcrumb a {
    color: var(--color-slate-gray);
  }

  .res-breadcrumb a:hover {
    color: var(--color-electric-blue);
  }

  .res-breadcrumb span[aria-current] {
    color: var(--color-near-black);
    font-weight: 600;
  }

  .resource-header {
    max-width: 760px;
    margin-inline: auto;
  }

  .res-article-eyebrow {
    color: var(--color-electric-blue);
    display: inline-block;
    margin-bottom: 12px;
  }

  .res-article-h1 {
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .res-article-desc {
    font-size: 1.05rem;
    color: var(--color-slate-gray);
    line-height: 1.6;
    margin-bottom: 8px;
  }

  /* Core Sprint 10.3 fix: the article body is a wide, centered block
     (not left-biased within a much wider Container) so that widening it
     for diagrams doesn't create dead space on the right. Text elements
     inside get their own centered, narrower reading column; visual
     framework wrappers are allowed to use most of the wider block. */
  .res-article-body {
    max-width: 1120px;
    margin-inline: auto;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-near-black);
  }

  .res-article-body :global(h2),
  .res-article-body :global(p),
  .res-article-body :global(ul),
  .res-article-body :global(ol) {
    max-width: 760px;
    margin-inline: auto;
  }

  .res-article-body :global(h2) {
    font-size: 1.4rem;
    font-weight: 800;
    margin-block: 40px 16px;
  }

  .res-article-body :global(p) {
    margin-bottom: 18px;
    color: var(--color-slate-gray);
  }

  .res-article-body :global(strong) {
    color: var(--color-near-black);
  }

  .res-article-body :global(a) {
    color: var(--color-electric-blue);
    font-weight: 600;
  }

  .res-article-body :global(ul),
  .res-article-body :global(ol) {
    margin-bottom: 18px;
    padding-left: 24px;
    color: var(--color-slate-gray);
    text-align: left;
  }

  .res-article-body :global(li) {
    margin-bottom: 6px;
  }

  /* Visual framework breakout — the wide, centered diagram treatment.
     These wrappers intentionally do NOT inherit the 760px text max-width
     above, so they expand to use most of the wider 1120px article-body
     block, centered on the same axis as the prose. */
  .res-article-body :global(.gf-wrap),
  .res-article-body :global(.qm-wrap),
  .res-article-body :global(.cap-grid) {
    max-width: 100%;
    margin-block: 32px;
    margin-inline: auto;
  }

  .res-article-body :global(.gf-wrap) {
    background-color: var(--color-cloud-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-panel);
    padding: 32px 28px;
  }

  .res-article-body :global(.gf-group) {
    padding: 24px 22px;
  }

  .res-article-body :global(.gf-step) {
    padding: 13px 16px;
    font-size: 0.95rem;
  }

  .res-article-body :global(.qm-wrap) {
    max-width: 100%;
    padding: 12px 0;
  }

  @media (min-width: 700px) {
    .res-article-body :global(.qm-wrap) {
      padding: 12px 40px;
    }
  }

  .res-article-body :global(.cap-grid) {
    gap: 18px;
  }

  .res-article-body :global(.cap-card) {
    padding: 26px 22px;
    border-width: 1.5px;
  }

  .res-article-body :global(.cap-title) {
    font-size: 1.05rem;
  }

  /* Resource 4 specific: makes "Closed Revenue" read as the deliberate end
     state of the attribution system, matching the emphasis language
     already used for QuadrantMatrix's "Strategic Projects" highlight. */
  .res-article-body :global(.outcome-emphasis .gf-group:last-child) {
    background-color: rgba(37, 99, 235, 0.06);
    border-color: var(--color-electric-blue);
    border-width: 2px;
    box-shadow: 0 8px 24px -14px rgba(37, 99, 235, 0.35);
  }

  .res-article-body :global(.outcome-emphasis .gf-group:last-child .gf-group-label) {
    color: var(--color-electric-blue);
    font-size: 0.75rem;
  }

  .res-article-body :global(.outcome-emphasis .gf-group:last-child .gf-step) {
    border-color: var(--color-electric-blue);
    background-color: var(--color-pure-white);
    font-weight: 800;
    color: var(--color-electric-blue);
  }

  .res-article-body :global(.outcome-emphasis .gf-group:last-child .gf-step-icon) {
    color: var(--color-electric-blue);
  }

  .res-article-ctas {
    max-width: 760px;
    margin-inline: auto;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-light);
  }

  /* Resource CTA labels tend to be longer and more descriptive than the
     site's typical short button text (e.g. "Explore Responsible AI
     Systems for Financial Services"). Allow wrapping here specifically
     so a long label doesn't overflow narrow viewports, without touching
     the shared Button component's default nowrap behavior used
     elsewhere on the site. */
  .res-article-ctas :global(.btn) {
    white-space: normal;
    text-align: center;
    max-width: 100%;
  }

  .res-secondary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 16px;
  }

  .res-secondary-links a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-slate-gray);
  }

  .res-secondary-links a:hover {
    color: var(--color-electric-blue);
  }

  .res-related-h2 {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 24px;
    text-align: center;
  }

  .res-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 900px;
    margin-inline: auto;
  }

  .res-related-card {
    display: block;
    background-color: var(--color-cloud-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-panel);
    padding: 20px 18px;
  }

  .res-related-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--color-near-black);
  }

  .res-related-card p {
    font-size: 0.85rem;
    color: var(--color-slate-gray);
    line-height: 1.5;
  }

  @media (min-width: 700px) {
    .res-related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
