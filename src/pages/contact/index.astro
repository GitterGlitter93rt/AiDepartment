---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import InteriorHero from '../../components/interior/InteriorHero.astro';
import SectionHeading from '../../components/interior/SectionHeading.astro';
import FAQSection from '../../components/interior/FAQSection.astro';
import { SCHEDULING } from '../../lib/site';

const paths = [
  {
    icon: 'clipboard-check',
    title: 'AI Department Assessment',
    bestFor: 'Companies unsure where to begin, or evaluating opportunities across multiple areas.',
    ctaLabel: 'Take the AI Department Assessment',
    href: '/free-ai-assessment/',
  },
  {
    icon: 'target',
    title: SCHEDULING.strategyCall.label,
    bestFor: 'Business owners, CEOs, and executives with urgent AI priorities or a larger engagement in mind.',
    ctaLabel: `Book a Free ${SCHEDULING.strategyCall.durationMinutes}-Minute Call`,
    href: SCHEDULING.strategyCall.url,
  },
  {
    icon: 'building-2',
    title: SCHEDULING.enterpriseDiscussion.label,
    bestFor: 'Larger or more complex organizations evaluating AI across multiple departments.',
    ctaLabel: 'Discuss an Enterprise Engagement',
    href: SCHEDULING.enterpriseDiscussion.url,
  },
  {
    icon: 'graduation-cap',
    title: SCHEDULING.trainingConsultation.label,
    bestFor: 'Leadership teams considering employee training or company-wide AI adoption.',
    ctaLabel: 'Discuss AI Training',
    href: SCHEDULING.trainingConsultation.url,
  },
  {
    icon: 'compass',
    title: SCHEDULING.executiveAdvisory.label,
    bestFor: `Business owners and executives wanting focused, one-on-one advisory time. ${SCHEDULING.executiveAdvisory.price} · ${SCHEDULING.executiveAdvisory.durationMinutes} minutes.`,
    ctaLabel: 'Book the Advisory Session',
    href: SCHEDULING.executiveAdvisory.url,
  },
];

const interestOptions = [
  'AI Department Assessment', 'Executive AI Strategy', 'AI Consulting', 'AI Implementation',
  'Managed AI Department', 'AI Training', 'AI Workshops', 'Executive AI Coaching',
  'Google Ads', 'Meta Ads', 'SEO', 'Marketing Automation', 'AI Phone Agents',
  'AI Sales Automation', 'Workflow Automation', 'Custom AI Agents', 'Software Integration', 'Other',
];

const timingOptions = ['Just researching', 'Within 6 months', 'Within 3 months', 'Within 30 days', 'Immediately'];

const faqs = [
  { question: 'What is the best way to get started?', answer: 'For most companies, the AI Department Assessment is a useful starting point. It helps identify where AI, automation, marketing, and improved systems may create value.' },
  { question: 'Can I schedule a call without taking the assessment?', answer: 'Yes. Companies with a specific opportunity or urgent project can schedule a strategy conversation directly using the form below.' },
  { question: 'Do you work with small businesses?', answer: 'Yes. The appropriate engagement depends on company size, complexity, and potential business value.' },
  { question: 'Do you work with larger companies?', answer: 'Yes. Larger organizations may require broader strategy, implementation, training, integration, and ongoing management.' },
  { question: 'Can you help with both AI and marketing?', answer: 'Yes. Your AI Department can help with AI strategy, implementation, automation, Google Ads, Meta Ads, SEO, CRM, lead follow-up, and growth systems.' },
];
---

<BaseLayout
  title="Contact Your AI Department"
  description="Talk to our team about AI strategy, implementation, automation, or training — or book a free strategy call and leave with a clear recommended next step."
  path="/contact/"
>
  <InteriorHero
    eyebrow="Get in Touch"
    headline="Tell Us What You Want to Improve"
    support="Whether you want to adopt AI, automate repetitive work, improve marketing, train employees, build AI agents, or develop a complete AI roadmap, we can help you identify the right next step."
    primaryCta={{ label: 'Start With the AI Department Assessment', href: '/free-ai-assessment/' }}
    secondaryCta={{ label: 'Schedule a Strategy Call', href: '#contact-form' }}
  />

  <Section tone="light">
    <Container wide>
      <SectionHeading
        eyebrow="Choose Your Path"
        heading="Different Companies Need Different Starting Points"
      />
      <div class="path-grid">
        {paths.map((path) => (
          <div class="path-card">
            <span class="path-icon"><Icon name={path.icon} size={22} /></span>
            <h3>{path.title}</h3>
            <p class="path-best-for"><strong>Best for:</strong> {path.bestFor}</p>
            <a href={path.href} class="path-cta">{path.ctaLabel} →</a>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="dark" id="contact-form">
    <Container>
      <SectionHeading
        eyebrow="Contact Form"
        heading="Get Started"
        support="We typically respond to qualified business inquiries within one business day."
        tone="dark"
      />

      <form id="contact-page-form" class="contact-form" novalidate>
        <input type="checkbox" name="botcheck" class="cf-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="cf-row">
          <label class="cf-field"><span>First Name *</span><input type="text" name="firstName" required autocomplete="given-name" /></label>
          <label class="cf-field"><span>Last Name</span><input type="text" name="lastName" autocomplete="family-name" /></label>
        </div>
        <div class="cf-row">
          <label class="cf-field"><span>Business Email *</span><input type="email" name="email" required autocomplete="email" /></label>
          <label class="cf-field"><span>Phone</span><input type="tel" name="phone" autocomplete="tel" /></label>
        </div>
        <div class="cf-row">
          <label class="cf-field"><span>Company Name</span><input type="text" name="company" autocomplete="organization" /></label>
          <label class="cf-field"><span>Company Website</span><input type="url" name="website" placeholder="https://" /></label>
        </div>
        <div class="cf-row">
          <label class="cf-field">
            <span>Primary Area of Interest</span>
            <select name="interest">
              <option value="">Select one…</option>
              {interestOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </label>
          <label class="cf-field">
            <span>How Soon Are You Looking to Move Forward?</span>
            <select name="timing">
              <option value="">Select one…</option>
              {timingOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </label>
        </div>
        <label class="cf-field cf-field-full">
          <span>How Can We Help? *</span>
          <textarea name="message" rows="4" required></textarea>
        </label>

        <label class="cf-checkbox">
          <input type="checkbox" name="consent" required />
          <span>By submitting this form, you agree that Your AI Department may contact you regarding your inquiry. See our <a href="/privacy/">Privacy Policy</a> and <a href="/terms/">Terms of Use</a>.</span>
        </label>

        <div id="cf-error" class="cf-error" role="alert" hidden></div>

        <Button type="submit" variant="primary" size="large">Send Message</Button>
      </form>

      <div id="cf-success" class="cf-success" hidden>
        <Icon name="check-circle-2" size={28} />
        <h3>Thank you — your message has been received.</h3>
        <p>We review inquiries and typically respond within one business day. In the meantime, you're welcome to <a href="/free-ai-assessment/">take the free AI Department Assessment</a>.</p>
      </div>
    </Container>
  </Section>

  <Section tone="light">
    <Container>
      <SectionHeading eyebrow="FAQ" heading="Common Questions" />
      <FAQSection items={faqs} />
    </Container>
  </Section>
</BaseLayout>

<script>
  import { buildLeadAttributionFields, generateLeadId } from '../../lib/attribution';
  const form = document.getElementById('contact-page-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('cf-error');
  const successBox = document.getElementById('cf-success');

  // FORM DELIVERY — Web3Forms (https://web3forms.com)
  //
  // Web3Forms is a form-backend service purpose-built for static sites
  // with no custom server — exactly this site's architecture (Astro
  // output:'static', deployed as flat files to SiteGround). It is not a
  // bare mail() call and requires no server-side code of our own.
  //
  // SETUP: this form is connected to a Web3Forms account registered to
  // michael@youraidepartment.ai. Submissions are delivered to that inbox.
  // The Access Key below is a public, form-specific submission token, not
  // an account secret — this is Web3Forms' documented, intended
  // client-side usage pattern, consistent with "no secrets exposed in
  // browser JavaScript." If this key is ever rotated (e.g. the Web3Forms
  // account changes), replace the value below — no other code changes
  // are needed. If the key is ever missing/invalid, the form fails
  // honestly (a clear error state directing the user to email us
  // directly) rather than claiming a message was delivered.
  const WEB3FORMS_ACCESS_KEY = 'aef33e06-d5f2-450f-86f3-1908340e7e5d';
  const WEB3FORMS_ENDPOINT = 'https://api.web3forms.com/submit';

  async function submitContactForm(data: Record<string, string>): Promise<{ delivered: boolean }> {
    if (!WEB3FORMS_ACCESS_KEY || WEB3FORMS_ACCESS_KEY.startsWith('REPLACE_WITH')) {
      return { delivered: false };
    }
    try {
      const response = await fetch(WEB3FORMS_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: WEB3FORMS_ACCESS_KEY,
          subject: 'New inquiry from youraidepartment.ai',
          from_name: 'Your AI Department Website',
          ...data,
        }),
      });
      const result = await response.json().catch(() => null);
      return { delivered: Boolean(response.ok && result?.success) };
    } catch {
      return { delivered: false };
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !errorBox) return;
    errorBox.setAttribute('hidden', '');

    const fd = new FormData(form);

    // Honeypot: real users never see or check this field. If it's
    // filled, silently show success without actually submitting
    // anything — this avoids tipping off the bot while not sending spam.
    if (fd.get('botcheck')) {
      form.hidden = true;
      successBox?.removeAttribute('hidden');
      return;
    }

    const firstName = String(fd.get('firstName') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const message = String(fd.get('message') || '').trim();
    const consent = fd.get('consent');

    if (!firstName || !email || !message) {
      errorBox.textContent = 'Please complete all required fields.';
      errorBox.removeAttribute('hidden');
      return;
    }
    if (!consent) {
      errorBox.textContent = 'Please acknowledge the consent statement to continue.';
      errorBox.removeAttribute('hidden');
      return;
    }
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailPattern.test(email)) {
      errorBox.textContent = 'Please enter a valid business email address.';
      errorBox.removeAttribute('hidden');
      return;
    }

    const payload: Record<string, string> = {};
    fd.forEach((value, key) => { payload[key] = String(value); });

    // Non-PII acquisition context and a correlation ID, attached to the
    // lead payload so the received email includes where this contact
    // actually came from. None of this is derived from or contains the
    // submitter's name/email/phone/message.
    const leadId = generateLeadId();
    payload.lead_id = leadId;
    Object.assign(payload, buildLeadAttributionFields());

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    const result = await submitContactForm(payload);
    if (submitBtn) submitBtn.disabled = false;

    if (!result.delivered) {
      errorBox.textContent = 'We could not send your message right now. Please email us directly at michael@youraidepartment.ai.';
      errorBox.removeAttribute('hidden');
      return;
    }

    // Fires only here — after genuine delivery succeeded — so this event
    // represents a real, complete submission, never a failed one.
    // lead_id is a non-PII correlation identifier (see
    // src/lib/attribution.ts) — no name/email/phone/message is ever
    // added to this or any other GA4 event.
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: 'contact_form_submit', lead_id: leadId });

    form.hidden = true;
    successBox?.removeAttribute('hidden');
  });
</script>

<style>
  .path-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .path-card {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-card);
    padding: 22px 20px;
    box-shadow: 0 2px 8px -4px rgba(17, 24, 39, 0.06);
  }

  .path-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-card);
    background-color: rgba(37, 99, 235, 0.08);
    color: var(--color-electric-blue);
    margin-bottom: 14px;
  }

  .path-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .path-best-for {
    font-size: 0.85rem;
    color: var(--color-slate-gray);
    line-height: 1.5;
    margin-bottom: 14px;
  }

  .path-cta {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-electric-blue);
  }

  .cf-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
    left: -9999px;
  }

  .contact-form {
    max-width: 720px;
    margin-inline: auto;
  }

  .cf-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .cf-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
    font-size: 0.82rem;
    color: var(--color-dark-muted-text);
  }

  .cf-field input,
  .cf-field select,
  .cf-field textarea {
    background-color: var(--color-midnight-navy);
    border: 1px solid var(--color-border-dark);
    border-radius: 8px;
    color: var(--color-pure-white);
    padding: 10px 12px;
    font-size: 0.92rem;
    font-family: var(--font-body);
  }

  .cf-field textarea {
    resize: vertical;
  }

  .cf-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.78rem;
    color: var(--color-dark-muted-text);
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .cf-checkbox input {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    accent-color: var(--color-electric-blue);
  }

  .cf-checkbox a {
    color: var(--color-signal-cyan);
  }

  .cf-error {
    color: #fca5a5;
    background-color: rgba(220, 38, 38, 0.12);
    border: 1px solid rgba(220, 38, 38, 0.35);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.85rem;
    margin-bottom: 16px;
  }

  .cf-success {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    color: var(--color-pure-white);
  }

  .cf-success :global(svg) {
    color: var(--color-emerald);
    margin-bottom: 12px;
  }

  .cf-success h3 {
    font-size: 1.15rem;
    margin-bottom: 10px;
  }

  .cf-success p {
    color: var(--color-dark-muted-text);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .cf-success a {
    color: var(--color-signal-cyan);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .path-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cf-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .path-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
