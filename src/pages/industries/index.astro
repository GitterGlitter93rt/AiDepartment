---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import CTABand from '../../components/interior/CTABand.astro';
import { PRIMARY_CTA } from '../../lib/site';
import { industriesByCategory } from '../../lib/industries';

// Single source of truth: src/lib/industries.ts. Adding an industry
// there is sufficient — this page, the nav mega-menu, and the footer all
// derive from the same registry, so nothing needs to be duplicated here.
const categoriesData = industriesByCategory();
const categories = categoriesData.map((cat) => ({
  name: cat.category,
  industries: cat.items.map((i) => ({ name: i.name, href: i.href, description: i.description })),
}));
---

<BaseLayout
  title="Industries We Serve | Your AI Department"
  description="Explore AI and automation systems built for your industry, from home services and real estate to enterprise sectors like financial services and defense."
  path="/industries/"
>
  <Section tone="dark">
    <Container>
      <span class="eyebrow ind-eyebrow">Industries</span>
      <h1 class="ind-hub-h1">Industries We Serve</h1>
      <p class="ind-hub-support">Every industry page reflects real workflows and business economics specific to that trade or sector — not a generic template with the industry name swapped in. Explore the page built for your business below.</p>
    </Container>
  </Section>

  {categories.map((cat, i) => (
    <Section tone={i % 2 === 0 ? 'light' : 'white'}>
      <Container wide>
        <h2 class="ind-cat-heading">{cat.name}</h2>
        <div class="ind-grid">
          {cat.industries.map((ind) => (
            <a href={ind.href} class="ind-card" aria-label={`Explore AI for ${ind.name}`}>
              <h3>{ind.name}</h3>
              <p>{ind.description}</p>
              <span class="ind-card-link">Explore this industry &rarr;</span>
            </a>
          ))}
        </div>
      </Container>
    </Section>
  ))}

  <CTABand
    icon="clipboard-check"
    heading="Not Sure Which Industry Page Fits?"
    support="Take the free AI Department Assessment to see where AI, automation, and better systems may create value in your specific business."
    primaryCta={PRIMARY_CTA}
    microcopy="Free • 7-12 Minutes • No Commitment"
  />
</BaseLayout>

<style>
  .ind-eyebrow {
    color: var(--color-signal-cyan);
    display: inline-block;
    margin-bottom: 14px;
  }

  .ind-hub-h1 {
    color: var(--color-pure-white);
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.15;
    max-width: 760px;
    margin-bottom: 16px;
  }

  .ind-hub-support {
    color: var(--color-dark-muted-text);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 640px;
  }

  .ind-cat-heading {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-near-black);
    margin-bottom: 20px;
  }

  .ind-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .ind-card {
    display: block;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-panel);
    padding: 20px 20px;
    box-shadow: 0 2px 8px -4px rgba(17, 24, 39, 0.06);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .ind-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-light);
  }

  .ind-card h3 {
    font-size: 1.02rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: var(--color-near-black);
    line-height: 1.35;
  }

  .ind-card p {
    font-size: 0.86rem;
    color: var(--color-slate-gray);
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .ind-card-link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.84rem;
    color: var(--color-electric-blue);
  }

  @media (min-width: 700px) {
    .ind-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .ind-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
