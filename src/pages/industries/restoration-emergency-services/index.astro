---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Container from '../../../components/Container.astro';
import InteriorHero from '../../../components/interior/InteriorHero.astro';
import SectionHeading from '../../../components/interior/SectionHeading.astro';
import CapabilityGrid from '../../../components/interior/CapabilityGrid.astro';
import GroupedFlow from '../../../components/interior/GroupedFlow.astro';
import WhoItsFor from '../../../components/interior/WhoItsFor.astro';
import FAQSection from '../../../components/interior/FAQSection.astro';
import CTABand from '../../../components/interior/CTABand.astro';
import { PRIMARY_CTA, SECONDARY_CTA, SITE } from '../../../lib/site';

const opportunityAreas = [
  { icon: 'phone', title: '24/7 Lead Intake', description: 'After-hours voice and digital intake that captures urgency, contact details, and property information, then routes the inquiry correctly.' },
  { icon: 'zap', title: 'Missed-Call Recovery', description: 'When an emergency inquiry gets missed, automated recovery creates rapid follow-up instead of letting the opportunity disappear.' },
  { icon: 'map', title: 'Geographic & Catastrophe Routing', description: 'During storms and catastrophe deployments, incoming work routed by geography, service area, crew availability, and priority.' },
  { icon: 'users', title: 'Technician & Estimator Coordination', description: 'Assignment, scheduling, reminders, and information handoff — supporting field judgment, never replacing it.' },
  { icon: 'message-square', title: 'Customer Status Communication', description: 'Structured updates that reduce unnecessary inbound calls while keeping human escalation available for sensitive situations.' },
  { icon: 'file-text', title: 'Documentation Intake', description: 'Organized intake of photos, property information, and documents, with appropriate controls around sensitive information.' },
  { icon: 'bar-chart-3', title: 'Marketing & Attribution', description: 'Connect calls, forms, campaigns, and referral sources to jobs and revenue so management knows which channels produce qualified work.' },
];

const responseGroups = [
  { label: 'Event', steps: [{ text: 'Water / Fire / Storm Loss', icon: 'alert-triangle' }] },
  { label: 'Intake & Triage', steps: [{ text: 'Call / Form / SMS / Referral', icon: 'inbox' }, { text: 'Location, Service, Urgency', icon: 'search' }] },
  { label: 'Routing', steps: [{ text: 'Market / Team / Estimator', icon: 'map' }, { text: 'Technician Assignment', icon: 'users' }] },
  { label: 'Response', steps: [{ text: 'Dispatch / Appointment', icon: 'calendar' }, { text: 'Human Escalation', icon: 'user-check' }] },
  { label: 'Communication', steps: [{ text: 'Updates / Documents', icon: 'message-square' }, { text: 'Follow-Up', icon: 'repeat' }] },
  { label: 'Measurement', steps: [{ text: 'Lead Source / Response Time', icon: 'bar-chart-3' }, { text: 'Job / Revenue', icon: 'trending-up' }] },
];

const faqs = [
  { question: 'Can AI handle the initial call when someone has active water damage?', answer: 'AI-assisted intake can capture basic information, identify urgency, and get the right details to the right team quickly — especially after hours. It should not be the only line of defense for a distressed customer; human escalation needs to be immediate and easy to reach.' },
  { question: 'What happens when a hurricane hits and call volume spikes 10x overnight?', answer: 'This is exactly the scenario most day-to-day systems aren\'t built for. Catastrophe response needs intake, routing, and communication workflows specifically designed to handle sudden surge — not just a system that works fine at normal volume and breaks under real demand.' },
  { question: 'Do you provide insurance or claims guidance?', answer: 'No. Your AI Department does not provide legal, insurance, adjusting, or coverage advice. We help build the operational systems around intake, routing, and communication — the claims and coverage conversation stays with your team and the customer\'s insurer.' },
  { question: 'How do you handle sensitive customer information and documentation?', answer: 'Restoration work often involves property details, insurance information, and photos of a customer\'s home during a stressful event. Any system we help design includes access controls, data minimization, and clear escalation paths — not just automation for its own sake.' },
  { question: 'We use temporary crews and partners during catastrophe events. Can systems handle that?', answer: 'Yes, this is a normal part of catastrophe operations. Routing and coordination workflows can be designed to account for temporary teams and partner relationships during surge events, without requiring a permanent restructure of your day-to-day operations.' },
];
---

<BaseLayout
  title="AI Systems for Restoration and Emergency Response | Your AI Department"
  description="24/7 intake, catastrophe routing, dispatch coordination, and marketing attribution for restoration and emergency-response companies, built around real response-time pressure."
  path="/industries/restoration-emergency-services/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: `${SITE.domain}/industries/` },
      { '@type': 'ListItem', position: 3, name: 'Restoration & Emergency Services', item: `${SITE.domain}/industries/restoration-emergency-services/` },
    ],
  })} />

  <InteriorHero
    eyebrow="Restoration & Emergency Services"
    headline="AI Systems for Restoration and Emergency Response"
    support="When property damage happens, response time matters. Restoration businesses need systems that can capture urgent inquiries, route opportunities, coordinate teams, communicate with customers, and maintain visibility across rapidly changing jobs. Your AI Department helps build the connected systems behind that response."
    primaryCta={PRIMARY_CTA}
    secondaryCta={SECONDARY_CTA}
  />

  <Section tone="light">
    <Container>
      <SectionHeading
        eyebrow="Why This Is Different"
        heading="Emergency Work Exposes Broken Systems Quickly"
      />
      <p class="prose-p">A missed call, a delayed assignment, an incomplete intake, a poor handoff, or a disconnected communication process is an inconvenience in most industries. In restoration, it's a serious operational problem, because the customer on the other end of that missed call is usually dealing with active water damage, fire loss, storm damage, or another urgent event that's getting worse while they wait. Water mitigation, fire and smoke restoration, mold-related work, emergency stabilization, and storm response all share the same underlying pressure: the value of a fast, well-coordinated response is highest exactly when a business's systems are most likely to be under strain.</p>
      <p class="prose-p">The goal here isn't maximum automation. It's reliable coordination when speed, information quality, and human judgment all matter at the same time — whether that's a single water-damage call on a Tuesday night or two hundred storm-damage calls in the 48 hours after a hurricane makes landfall.</p>
    </Container>
  </Section>

  <Section tone="white">
    <Container wide>
      <SectionHeading
        eyebrow="Key Opportunity Areas"
        heading="Where Coordination Breaks Down Under Pressure"
      />
      <CapabilityGrid items={opportunityAreas} columns={4} tone="light" />
    </Container>
  </Section>

  <Section tone="dark">
    <Container wide>
      <SectionHeading
        eyebrow="System Framework"
        heading="From Emergency Inquiry to Coordinated Response"
        support="This is a conceptual pattern, not a claim that every restoration business should implement the same architecture."
        tone="dark"
      />
      <GroupedFlow groups={responseGroups} tone="dark" />
    </Container>
  </Section>

  <Section tone="light">
    <Container>
      <SectionHeading
        eyebrow="Catastrophe Response"
        heading="Build Systems That Can Scale When Demand Spikes"
      />
      <p class="prose-p">Storm and catastrophe events can create sudden increases in calls, leads, geographic coverage, temporary crews, partner relationships, and operational complexity — all at once. A system designed only around normal daily volume can quietly break down exactly when it's needed most, at the worst possible moment for both the business and the customers waiting for help.</p>
      <p class="prose-p">AI and automation can support surge intake, catastrophe-specific routing, mass communication, reporting, and cross-team coordination during these events. Experienced people remain responsible for field decisions, estimates, customer situations, and the operational judgment that determines how crews and territories actually get managed during a surge — automation's job is to keep the intake and communication layer functioning at ten times normal volume, not to make the judgment calls.</p>
    </Container>
  </Section>

  <Section tone="dark">
    <Container>
      <SectionHeading
        eyebrow="Privacy & Human Judgment"
        heading="Sensitive Situations Require Responsible Automation"
        support="Restoration workflows may involve insurance information, property details, customer documents, photographs, and stressful customer situations. AI systems should be implemented with appropriate access controls, data minimization, escalation, and human review. Your AI Department does not provide legal, insurance, adjusting, or coverage advice."
        tone="dark"
      />
    </Container>
  </Section>

  <Section tone="light">
    <Container>
      <SectionHeading
        eyebrow="Who This Is For"
        heading="Built for Operators Managing Real Response Complexity"
      />
      <WhoItsFor
        fitHeading="A strong fit for organizations that are:"
        fitItems={[
          'Water mitigation companies',
          'Full-service restoration companies',
          'Fire and smoke restoration businesses',
          'Multi-market restoration operators',
          'Catastrophe-response organizations',
          'Coordinating multiple crews, estimators, or territories',
        ]}
        notFitHeading="May not be the right fit if:"
        notFitItems={[
          'You are a very small operator with minimal volume',
          'You are seeking a fully autonomous claims or estimating system',
          'You are unwilling to maintain human oversight for high-stakes decisions',
        ]}
      />
    </Container>
  </Section>

  <Section tone="dark">
    <Container>
      <SectionHeading eyebrow="FAQ" heading="Common Questions" tone="dark" />
      <FAQSection items={faqs} />
    </Container>
  </Section>

  <Section tone="light">
    <Container>
      <SectionHeading
        eyebrow="Next Steps"
        heading="Strategy, Implementation, and Ongoing Support"
      />
      <p class="cross-links">
        <a href="/ai-consulting/">AI Consulting</a>&nbsp;&bull;&nbsp;
        <a href="/ai-implementation/">AI Implementation</a>&nbsp;&bull;&nbsp;
        <a href="/ai-growth-systems/">AI Growth Systems</a>&nbsp;&bull;&nbsp;
        <a href="/managed-ai-department/">Managed AI Department</a>&nbsp;&bull;&nbsp;
        <a href="/google-ads/">Explore Google Ads Management</a>
      </p>
      <p class="cross-links">
        <a href="/resources/why-speed-to-lead-matters/">Why Speed-to-Lead Matters</a>&nbsp;&bull;&nbsp;
        <a href="/resources/how-to-track-google-ads-leads-to-revenue/">How to Track Google Ads Leads to Revenue</a>
      </p>
      <p class="cross-links">
        <a href="/resources/ai-for-24-7-restoration-lead-intake/">AI for 24/7 Restoration Lead Intake</a>&nbsp;&bull;&nbsp;
        <a href="/resources/how-restoration-companies-can-improve-emergency-lead-response/">How Restoration Companies Can Improve Emergency Lead Response</a>&nbsp;&bull;&nbsp;
        <a href="/resources/how-restoration-companies-can-track-leads-to-jobs-and-revenue/">How Restoration Companies Can Track Leads to Jobs and Revenue</a>
      </p>
    </Container>
  </Section>

  <CTABand
    icon="clipboard-check"
    heading="Find Where AI Can Improve Your Response Systems"
    support="Take the free AI Department Assessment to see your opportunities across intake, routing, and catastrophe readiness."
    primaryCta={PRIMARY_CTA}
    microcopy="Free • 3-4 Minutes • No Commitment"
  />
</BaseLayout>

<style>
  .prose-p {
    color: var(--color-slate-gray);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 760px;
    margin-inline: auto;
    margin-bottom: 18px;
  }

  .cross-links {
    text-align: center;
    font-size: 0.9rem;
    margin-bottom: 8px;
  }

  .cross-links a {
    color: var(--color-electric-blue);
    font-weight: 600;
  }
</style>
